{
  "name": "@tetherto/mdk-mcp",
  "version": "0.6.0",
  "description": "MDK MCP Server",
  "main": "server.js",
  "keywords": [
    "tether"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "npm run lint && npm run test:unit && npm run test:integration",
    "test:unit": "NODE_ENV=test brittle tests/unit/*.test.js",
    "test:integration": "NODE_ENV=test brittle tests/integration/*.test.js",
    "test:coverage": "NODE_ENV=test brittle --coverage 'tests/**/*.test.js'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "async": "3.2.6",
    "debug": "4.4.1"
  },
  "overrides": {
    "@hono/node-server": "2.0.12",
    "brace-expansion": "5.0.9",
    "hono": ">=4.12.34"
  },
  "devDependencies": {
    "brittle": "3.18.0",
    "standard": "17.1.0"
  }
}
